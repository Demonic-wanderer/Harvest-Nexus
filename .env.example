PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://username:password@host:5432/harvest_nexus
JWT_SECRET=replace_with_a_32_plus_character_random_secret
JWT_EXPIRES_IN=1d
DB_SSL=false
# Leave blank during a local Flutter web demo: Chrome chooses a random localhost port.
# Set explicit origins when deploying a shared or production environment.
CORS_ORIGINS=
ORACLE_SERVICE_KEY=replace_with_a_long_random_oracle_key
ADVISORY_SERVICE_KEY=replace_with_a_long_random_advisory_key
INSIGHT_SERVICE_KEY=replace_with_a_long_random_insight_key
IOT_ROVER_SERVICE_KEY=replace_with_a_long_random_iot_rover_key
FORGE_BASE_URL=http://localhost:5000
FORGE_ENABLED=true
MARKET_PRICE_API_KEY=
GOV_AGRI_DATA_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a24601d3dead
